# Required
APP_PASSWORD=change-me

# Optional: keeps sessions valid across restarts. Defaults to one derived from APP_PASSWORD.
SESSION_SECRET=

# Local disk storage (used when S3_BUCKET is empty)
STORAGE_DIR=./data/vault

# S3-compatible storage (Cloudflare R2, Backblaze B2, AWS S3...)
S3_BUCKET=
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PREFIX=

# Per-file upload limit in MB
MAX_UPLOAD_MB=2048
